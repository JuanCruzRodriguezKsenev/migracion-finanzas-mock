# Conexión a PostgreSQL (local o Neon). Obligatorio (validado vía Zod en src/shared/lib/env.ts)
# En producción (Vercel) es la cadena CON pooler de Neon (host con "-pooler"): el cliente desactiva
# las sentencias preparadas solo. Para migrar o correr db:bootstrap usar la cadena directa. Ver docs/DEPLOY.md
DATABASE_URL=postgresql://postgres:postgres_dev_pwd@localhost:5432/finanzas_db

# Secreto de firma de JWT para NextAuth. Obligatorio en producción.
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL canónica de la aplicación para NextAuth (ej: http://localhost:3000)
# En producción: https://<dominio>  (con HTTPS NextAuth usa la cookie de sesión __Secure-)
NEXTAUTH_URL=http://localhost:3000

# Opcional: habilita metadatos enriquecidos de marcas (logos, colores corporativos)
# vía Brandfetch. Sin esta key, el sistema usa un fallback con Clearbit.
BRANDFETCH_API_KEY=
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=brandfetch

# Opcional: autenticación con Google OAuth. Ambas o ninguna.
# Crear credenciales OAuth 2.0 (Aplicación web) en Google Cloud Console.
# URI de redireccionamiento autorizada en desarrollo: http://localhost:3000/api/auth/callback/google
# En producción agregar también: https://<dominio>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

