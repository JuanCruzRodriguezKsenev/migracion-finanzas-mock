# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prohibición de acceso crítica
/migracion

# Enlaces simbólicos locales hacia las skills, cuyo contenido real SÍ está
# versionado en `.agents/skills/` —el lugar neutro, que sirve a cualquier
# agente de IA—. Acá sólo viven los symlinks que Claude Code necesita para
# verlas, y son específicos de cada máquina.
# Al clonar en otra máquina hay que rehacerlos:
#   ln -s ../../.agents/skills/<nombre> .claude/skills/<nombre>
/.claude/skills/
